{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "removeComments": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "allowJs": false,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@watt/shared-types": ["packages/shared-types/src"],
      "@watt/shared-utils": ["packages/shared-utils/src"],
      "@watt/test-data-loader": ["packages/test-data-loader/src"],
      "@watt/cucumber-helpers": ["packages/cucumber-helpers/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
