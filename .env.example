# Environment variables for local development
# Copy this to .env and customize as needed

# Application
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://watt:watt_dev_password@localhost:5432/watt
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=watt
DATABASE_USER=watt
DATABASE_PASSWORD=watt_dev_password
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_URL=amqp://watt:watt_dev_password@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=watt
RABBITMQ_PASSWORD=watt_dev_password
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=watt
MINIO_SECRET_KEY=watt_dev_password
MINIO_USE_SSL=false

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Logging
LOG_LEVEL=debug

# Test Runner
TEST_RUNNER_HEADLESS=true
TEST_RUNNER_TIMEOUT=30000
TEST_RUNNER_RETRY_COUNT=2
TEST_RUNNER_VIDEO_ENABLED=true
TEST_RUNNER_SCREENSHOT_ON_FAILURE=true

# Integration Services
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
JIRA_URL=
JIRA_USERNAME=
JIRA_API_TOKEN=

# Azure DevOps
AZURE_DEVOPS_ORG_URL=
AZURE_DEVOPS_TOKEN=

# GitHub
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# GitLab
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_WEBHOOK_SECRET=
