{
  "name": "watt",
  "version": "0.1.0",
  "description": "Web Application Test Tool - Containerized Platform for Automated Testing",
  "private": true,
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "install:all": "npm install && npm run install:services && npm run install:packages",
    "install:services": "npm install --workspace=services/*",
    "install:packages": "npm install --workspace=packages/*",
    "build": "npm run build:packages && npm run build:services",
    "build:packages": "npm run build --workspaces --if-present packages/*",
    "build:services": "npm run build --workspaces --if-present services/*",
    "dev": "make dev",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "clean": "make clean",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.3.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "playwright": "^1.57.0",
    "prettier": "^3.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/watt.git"
  },
  "keywords": [
    "testing",
    "automation",
    "playwright",
    "cucumber",
    "bdd",
    "kubernetes",
    "microservices"
  ],
  "author": "WATT Team",
  "license": "MIT"
}
